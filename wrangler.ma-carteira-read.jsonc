{
  "name": "ma-carteira-read",
  "main": "./worker/maCarteiraReadEntry.ts",
  "compatibility_date": "2026-04-03",
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "ma-code.pt/api/ma-carteira/wallet*",
      "zone_name": "ma-code.pt"
    },
    {
      "pattern": "www.ma-code.pt/api/ma-carteira/wallet*",
      "zone_name": "ma-code.pt"
    }
  ]
}
