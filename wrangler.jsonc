{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ma-code",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": ["nodejs_compat"]
}
